<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<!-- The plugin's metadata: Obsidian.MSBuild writes these into the archive's obsidian.mod.json. -->
	<PropertyGroup>
		<PluginId>obsidianplugin</PluginId>
		<Version>1.0.0</Version>
		<Title>Obsidian Plugin</Title>
		<Authors>Obsidian Team</Authors>
		<Description>A server-side sample: a dimension, a portal to it and a command counting visits.</Description>
		<ProjectUrl>https://github.com/ObsidianMC/ObsidianPlugin</ProjectUrl>

		<!-- Runs on the server only; the Obsidian client skips it. -->
		<PluginSide>server</PluginSide>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Obsidian.API brings the Nbt types too (Obsidian.Nbt.dll), which saved data and attachments use. The server
			provides both, and their dependencies, at runtime, so they're only compiled against: the .obby archive
			holds the plugin alone.
		-->
		<PackageReference Include="Obsidian.API" Version="1.1.0-nightly.*" ExcludeAssets="runtime" />

		<!-- Packs the build output into ObsidianPlugin.obby; a build tool only, so it isn't a dependency. -->
		<PackageReference Include="Obsidian.MSBuild" Version="2.0.*-*" PrivateAssets="all"
			IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

</Project>
